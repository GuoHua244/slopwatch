# Copy to .env (git-ignored) and fill in. Bun auto-loads .env from the repo
# root for both `bun run dev` and `bun test`.

# Superuser DSN — only needed once for `bun run setup-db` (apps/server).
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# App DSN printed by setup-db; slopwatch_test is the same with _test suffix.
DATABASE_URL=postgres://slopwatch:CHANGE_ME@localhost:5432/slopwatch
# Tests prefer this so they never touch the app database.
DATABASE_URL_TEST=postgres://slopwatch:CHANGE_ME@localhost:5432/slopwatch_test

# "name:token,name:token" — bearer tokens minted by the operator (v0: env, later: admin UI).
SLOPWATCH_TOKENS=alice:dev-token-change-me

# Operator bypass bearer for the admin plane (decision 13). Optional: the
# admin plane is open to users with the admin role; this token is the
# break-glass path (and the original bootstrap before any admin exists).
SLOPWATCH_ADMIN_TOKEN=change-me-admin-token

# Users granted the admin role at boot (ADR 0006), comma-separated. The
# bootstrap path to the first admin; later grants happen in the admin UI.
SLOPWATCH_ADMINS=alice

PORT=8787
RAW_TTL_DAYS=90

# S3-compatible cold archive for expired raw payloads (v2 decision 24).
# All four set = archiving on; leave any unset to prune without archiving.
# Self-hosted deployments: MinIO ships in docker-compose.yml.
SLOPWATCH_S3_ENDPOINT=http://localhost:9000
SLOPWATCH_S3_REGION=us-east-1
SLOPWATCH_S3_BUCKET=slopwatch-archive
SLOPWATCH_S3_ACCESS_KEY_ID=CHANGE_ME
SLOPWATCH_S3_SECRET_ACCESS_KEY=CHANGE_ME

# OIDC issuer (ADR 0005). Both set = the server also accepts RS256 JWTs the
# org IdP issued (JWKS-verified; identity maps by email claim then username,
# first sighting auto-provisions the user). Leave both unset for minted
# tokens only; a partial pair fails the boot.
SLOPWATCH_OIDC_ISSUER=
SLOPWATCH_OIDC_AUDIENCE=
